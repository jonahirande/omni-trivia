{
  "name": "trivia-app",
  "version": "1.0.0",
  "description": "Containerized Trivia App Backend (REST API + Socket.io Engine)",
  "main": "dist/api/server.js",
  "scripts": {
    "build": "tsc",
    "start:api": "node dist/api/server.js",
    "start:realtime": "node dist/realtime/realtime.js",
    "dev:api": "ts-node-dev --respawn --transpile-only src/api/server.ts",
    "dev:realtime": "ts-node-dev --respawn --transpile-only src/realtime/realtime.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "@socket.io/redis-adapter": "^8.2.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "ioredis": "^5.3.2",
    "socket.io": "^4.7.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.24",
    "prisma": "^5.10.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
